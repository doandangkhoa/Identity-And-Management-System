@startuml
title Sequence Diagram - Change Password

actor User
participant "Client App" as Client
participant "Auth API" as API
database DB

User -> Client: Nhập oldPass + newPass
Client -> API: PUT /change-password (Bearer token)

API -> DB: Verify session
DB --> API: session | null

alt Session không hợp lệ
    API --> Client: 401 Unauthorized
    Client --> User: Báo lỗi
else Session hợp lệ
    API -> DB: Get passwordHash
    DB --> API: passwordHash

    API -> API: Verify old password

    alt Sai mật khẩu cũ
        API --> Client: 400 Invalid old password
        Client --> User: Báo lỗi
    else Đúng mật khẩu cũ
        API -> API: Check newPass != oldPass

        alt Mật khẩu mới trùng mật khẩu cũ
            API --> Client: 400 New password must be different
            Client --> User: Báo lỗi
        else Khác mật khẩu cũ
            API -> API: Validate new password

            alt Password yếu
                API --> Client: 400 Weak password
                Client --> User: Báo lỗi
            else Hợp lệ
                API -> API: Hash password mới
                API -> DB: Update password
                DB --> API: OK

                API -> DB: Revoke all other sessions
                DB --> API: OK

                API --> Client: 200 Success
                Client --> User: Đổi mật khẩu thành công
            end
        end
    end
end

@enduml
