@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome

rectangle "Authentication & Session\nManagement" {

  usecase "Login" as UC1
  usecase "Recovery Password" as UC2
  usecase "Change Password" as UC3
  usecase "Manage Session" as UC4
  usecase "Logout" as UC5

  usecase "Check Account\nInformation" as UC6
  usecase "Authenticate MFA" as UC7
  usecase "Lock Account" as UC8
  usecase "Send OTP/Recovery Link" as UC9
  usecase "Check Login History" as UC10
  usecase "Revoke" as UC11
}

actor "User" as User
actor "Admin" as Admin
actor "Email Agent" as Agent

' ===== Actor =====
User -- UC1
User -- UC2
User -- UC3
User -- UC4
User -- UC5

Admin --|> User

UC9 -- Agent

' ===== Include =====
UC1 ..> UC6 : <<include>>
UC2 ..> UC9 : <<include>>
UC4 ..> UC10 : <<include>>

' ===== Extend =====
UC7 ..> UC1 : <<extend>>
UC8 ..> UC1 : <<extend>>
UC11 ..> UC4 : <<extend>>

' ===== Layout ép giống hình =====
UC1 -[hidden]down- UC2
UC2 -[hidden]down- UC3
UC3 -[hidden]down- UC4
UC4 -[hidden]down- UC5

UC6 -[hidden]down- UC7
UC7 -[hidden]down- UC8
UC8 -[hidden]down- UC9
UC9 -[hidden]down- UC10
UC10 -[hidden]down- UC11

UC1 -[hidden]right- UC6
UC2 -[hidden]right- UC9
UC4 -[hidden]right- UC10

User -[hidden]down- Admin

@enduml