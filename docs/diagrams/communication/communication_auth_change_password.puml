@startuml communication_auth_change_password

title 5.3.9. Sơ đồ giao tiếp - Change password

left to right direction
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 90
skinparam ranksep 90
skinparam rectangle {
  BorderColor #333333
  BackgroundColor #FFFFFF
  FontName Arial
  FontSize 12
}

frame "Interaction Change password" {
  actor "Người dùng" as user
  rectangle ": Frontend" as fe
  rectangle ": AuthService" as auth
  rectangle ": PasswordService" as pwd
  rectangle ": PolicyService" as policy
  rectangle ": SessionService" as session
  database "Database" as db

  user -[hidden]right- fe
  fe -[hidden]right- auth
  auth -[hidden]right- pwd
  pwd -[hidden]right- db
  policy -[hidden]down- pwd
  pwd -[hidden]down- session

  user -right-> fe : 1. Nhập mật khẩu cũ/mới
  fe -right-> auth : 2. PUT /auth/change-password
  auth -right-> pwd : 3. changePassword()
  pwd -right-> db : 4. Load user/passwordHash\n7. Check history\n8. Update password\n11. Ghi audit log
  pwd -up-> policy : 5. Kiểm tra policy mật khẩu
  policy -right-> db : 6. Load SecurityPolicy
  pwd -down-> session : 9. Thu hồi phiên khác
  session -right-> db : 10. Deactivate sessions
}

@enduml
