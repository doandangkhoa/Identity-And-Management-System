@startuml activity_auth_02_recovery_password

skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #2C3E50
  ArrowColor #2C3E50
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #2C3E50
}

title UC-AUTH-02: Khôi phục mật khẩu

|Người dùng|
start
:Chọn "Quên mật khẩu";
:Nhập email tài khoản;

|Hệ thống IAM|
:Kiểm tra định dạng email;

if (Email hợp lệ?) then (Không)
  :Trả lỗi định dạng email;
  |Người dùng|
  :Nhập lại email;
  stop
else (Có)
endif

|Hệ thống IAM|
:Tìm tài khoản theo email;

if (Email tồn tại?) then (Không)
  :Trả thông báo chung\nđể tránh lộ tài khoản;
  |Người dùng|
  :Xem hướng dẫn kiểm tra email;
  stop
else (Có)
endif

|Hệ thống IAM|
:UC-AUTH-02 include\nSend OTP/Recovery Link;
:Sinh OTP/link khôi phục\ncó thời hạn;
:Lưu mã/link khôi phục\nở trạng thái chờ xác nhận;

|Email Agent|
:Gửi OTP/link khôi phục\nqua email;

|Người dùng|
:Mở email;
:Nhập OTP hoặc truy cập link;

|Hệ thống IAM|
:Xác thực OTP/link khôi phục;

if (OTP/link hợp lệ?) then (Không)
  :Từ chối khôi phục mật khẩu;
  |Người dùng|
  :Yêu cầu gửi lại OTP/link;
  stop
else (Có)
endif

|Người dùng|
:Nhập mật khẩu mới;

|Hệ thống IAM|
:Kiểm tra rule mật khẩu;

if (Mật khẩu đạt yêu cầu?) then (Không)
  :Trả lỗi mật khẩu yếu;
  |Người dùng|
  :Nhập lại mật khẩu mới;
  stop
else (Có)
endif

|Hệ thống IAM|
:Hash mật khẩu mới;
:Cập nhật mật khẩu;
:Vô hiệu hóa OTP/link đã dùng;
:Thu hồi các phiên đang hoạt động;
:Ghi audit log PASSWORD_RESET;

|Người dùng|
:Nhận thông báo\nkhôi phục thành công;
stop

@enduml
