@startuml activity_sys_03_assign_role

skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #2C3E50
  ArrowColor #2C3E50
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #2C3E50
}

title UC-SYS-03: Phân quyền người dùng

|Quản trị viên|
start
:Chọn người dùng\ncần phân quyền;
:Chọn vai trò\ncho người dùng;

|Hệ thống|
:Gửi xác nhận\nthay đổi phân quyền;

|Quản trị viên|
:Xác nhận đồng ý;

|Hệ thống|
:Kiểm tra tính hợp lệ\ncủa vai trò;

if (Vai trò hợp lệ?) then (Không)
  :Từ chối cập nhật;
  |Quản trị viên|
  :Xem thông báo lỗi;
  stop
else (Có)
endif

|Hệ thống|
:Cập nhật bảng phân quyền\n(RBAC Table);
:Áp dụng quyền mới\ncho người dùng;
:Ghi audit log\nROLE_ASSIGNED;

|Quản trị viên|
:Xem thông báo\nphân quyền thành công;
stop

@enduml
