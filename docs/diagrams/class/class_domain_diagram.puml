@startuml IAM_MFA_Domain_Class_Diagram

title IAM/MFA System - Domain, Application Service and Event Class Diagram

top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 65
hide circle

' ===== ENUMS =====

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  INACTIVE
}

enum MfaType {
  TOTP
  WEBAUTHN
}

enum TokenType {
  ACCESS_TOKEN
  REFRESH_TOKEN
}

enum ClientType {
  PUBLIC
  CONFIDENTIAL
}

enum CodeChallengeMethod {
  PLAIN
  S256
}

enum GrantType {
  AUTHORIZATION_CODE
  REFRESH_TOKEN
  CLIENT_CREDENTIALS
  TOKEN_EXCHANGE
}

enum AuthenticatorTransport {
  USB
  NFC
  BLE
  INTERNAL
}

enum AuthenticationMethod {
  PASSWORD
  TOTP
  WEBAUTHN
  RECOVERY_CODE
}

enum AggregateType {
  USER
  USER_SESSION
  MFA_CREDENTIAL
  MFA_CHALLENGE
  OAUTH2_TOKEN
  REFRESH_TOKEN_FAMILY
  USER_ROLE
  ROLE_PERMISSION
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SensitivityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  MFA_ENABLED
  MFA_DISABLED
  MFA_VERIFIED
  PASSWORD_CHANGED
  USER_LOCKED
  USER_UNLOCKED
  ROLE_ASSIGNED
  ROLE_REVOKED
  TOKEN_ISSUED
  TOKEN_REVOKED
  REFRESH_TOKEN_ROTATED
  REFRESH_TOKEN_REUSE_DETECTED
  STEP_UP_REQUIRED
}

enum ChallengeStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

enum DomainEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  USER_LOCKED
  USER_UNLOCKED
  MFA_ENABLED
  MFA_DISABLED
  MFA_VERIFIED
  TOKEN_ISSUED
  TOKEN_REVOKED
  REFRESH_TOKEN_ROTATED
  REFRESH_TOKEN_REUSE_DETECTED
  ROLE_ASSIGNED
  ROLE_REVOKED
  STEP_UP_REQUIRED
}

' ===== DOMAIN ENTITIES =====

class User <<Entity>> {
  - id: String
  - username: String
  - email: String
  - passwordHash: String
  - status: UserStatus
  - version: Long
  - lastLoginAt: DateTime
  - createdAt: DateTime
  - updatedAt: DateTime
  --
  + updatePasswordHash(newPasswordHash: String): void
  + lockAccount(): void
  + unlockAccount(): void
}

class Role <<Entity>> {
  - id: String
  - roleName: String
  - description: String
  - isActive: Boolean
  - createdAt: DateTime
  - updatedAt: DateTime
  --
  + assignPermission(permission: Permission): void
  + revokePermission(permission: Permission): void
}

class Permission <<Entity>> {
  - id: String
  - permissionName: String
  - resource: String
  - action: String
  - sensitivityLevel: SensitivityLevel
  - isActive: Boolean
  --
  + matches(resource: String, action: String): Boolean
  + requiresStepUpAuth(): Boolean
}

class UserRole <<Association Entity>> {
  - userId: String
  - roleId: String
  - assignedAt: DateTime
  - assignedBy: String
}

class RolePermission <<Association Entity>> {
  - roleId: String
  - permissionId: String
  - grantedAt: DateTime
  - grantedBy: String
}

class ClientScopeGrant <<Association Entity>> {
  - oauth2ClientId: String
  - oauth2ScopeId: String
  - grantedAt: DateTime
  - grantedBy: String
}

class ScopePermission <<Association Entity>> {
  - oauth2ScopeId: String
  - permissionId: String
  - grantedAt: DateTime
  - grantedBy: String
}

class UserConsent <<Entity>> {
  - id: String
  - userId: String
  - oauth2ClientId: String
  - grantedScopeNames: List~String~
  - grantedAt: DateTime
  - revokedAt: DateTime
  --
  + isActive(): Boolean
  + revoke(): void
}

class PasswordHistory <<Entity>> {
  - id: String
  - userId: String
  - passwordHash: String
  - createdAt: DateTime
  --
  + isPasswordReused(newPasswordHash: String): Boolean
}

class PasswordResetToken <<Entity>> {
  - id: String
  - userId: String
  - tokenHash: String
  - expiresAt: DateTime
  - usedAt: DateTime
  - createdAt: DateTime
  --
  + isExpired(): Boolean
  + markUsed(): void
}

abstract class MfaCredential <<Entity>> {
  - id: String
  - userId: String
  - mfaType: MfaType
  - isVerified: Boolean
  - lastVerifiedAt: DateTime
  - createdAt: DateTime
  - updatedAt: DateTime
  --
  + verify(proof: String): Boolean
  + enable(): void
  + disable(): void
}

class TotpCredential <<Entity>> {
  - secretKeyEncrypted: String
  - algorithm: String
  - digits: Integer
  - periodSeconds: Integer
  --
  + verify(proof: String): Boolean
}

class WebAuthnCredential <<Entity>> {
  - credentialId: String
  - publicKey: String
  - signCount: Long
  - aaguid: String
  - transports: List~AuthenticatorTransport~
  - attestationType: String
  --
  + verify(proof: String): Boolean
  + updateSignCount(newSignCount: Long): void
  + isCloneSuspected(newSignCount: Long): Boolean
}

class RecoveryCodeSet <<Entity>> {
  - id: String
  - mfaCredentialId: String
  - generatedAt: DateTime
  - invalidatedAt: DateTime
  - codesRemaining: Integer
  --
  + regenerate(): List~RecoveryCode~
  + invalidate(): void
  + isActive(): Boolean
}

class RecoveryCode <<Entity>> {
  - id: String
  - recoveryCodeSetId: String
  - codeHash: String
  - isUsed: Boolean
  - usedAt: DateTime
  - createdAt: DateTime
  --
  + verify(plainCode: String): Boolean
  + markUsed(): void
}

class MfaChallenge <<Entity>> {
  - id: String
  - userId: String
  - mfaCredentialId: String
  - status: ChallengeStatus
  - attemptCount: Integer
  - maxAttempts: Integer
  - version: Long
  - expiresAt: DateTime
  - verifiedAt: DateTime
  - createdAt: DateTime
  --
  + canAttempt(): Boolean
  + recordFailedAttempt(): void
  + verify(proof: String): Boolean
  + expire(): void
}

class OAuth2Client <<Entity>> {
  - id: String
  - clientId: String
  - clientName: String
  - clientType: ClientType
  - clientSecretHash: String
  - redirectUri: String
  - grantTypes: List~String~
  - pkceRequired: Boolean
  - isActive: Boolean
  - createdAt: DateTime
  - updatedAt: DateTime
  --
  + authenticateClient(clientSecret: String): Boolean
  + validateRedirectUri(redirectUri: String): Boolean
  + requiresPkce(): Boolean
  + revokeClient(): void
}

class OAuth2Scope <<Entity>> {
  - id: String
  - scopeName: String
  - description: String
  - resource: String
  - sensitivityLevel: SensitivityLevel
  - isActive: Boolean
  --
  + matches(scopeName: String): Boolean
  + requiresStepUpAuth(): Boolean
}

class AuthorizationCode <<Entity>> {
  - id: String
  - userId: String
  - oauth2ClientId: String
  - codeHash: String
  - nonce: String
  - redirectUri: String
  - grantedScopeNames: List~String~
  - codeChallenge: String
  - codeChallengeMethod: CodeChallengeMethod
  - issuedAt: DateTime
  - expiresAt: DateTime
  - consumedAt: DateTime
  --
  + isExpired(): Boolean
  + isConsumed(): Boolean
  + verifyPkce(codeVerifier: String): Boolean
  + consume(): void
}

abstract class OAuth2Token <<Entity>> {
  - id: String
  - userId: String
  - oauth2ClientId: String
  - userSessionId: String
  - grantType: GrantType
  - tokenHash: String
  - tokenType: TokenType
  - grantedScopeNames: List~String~
  - issuedAt: DateTime
  - expiresAt: DateTime
  - revokedAt: DateTime
  --
  + isExpired(): Boolean
  + isRevoked(): Boolean
  + revoke(): void
}

class AccessToken <<Entity>> {
  - audience: String
  - permissionNames: List~String~
  - introspectionRequired: Boolean
  --
  + allows(resource: String, action: String): Boolean
}

class RefreshToken <<Entity>> {
  - refreshTokenFamilyId: String
  - parentTokenId: String
  - consumedAt: DateTime
  - reuseDetectedAt: DateTime
  - version: Long
  --
  + isConsumed(): Boolean
  + rotateTo(newRefreshToken: RefreshToken): void
  + markReuseDetected(): void
}

class IdToken <<Value Object>> {
  - issuer: String
  - subject: String
  - audience: String
  - issuedAt: DateTime
  - expiresAt: DateTime
  - nonce: String
  - acr: String
  - amr: List~AuthenticationMethod~
  - claims: Map~String,Object~
}

class RefreshTokenFamily <<Entity>> {
  - id: String
  - userId: String
  - oauth2ClientId: String
  - currentRefreshTokenId: String
  - version: Long
  - revokedAt: DateTime
  - reuseDetectedAt: DateTime
  - createdAt: DateTime
  - updatedAt: DateTime
  --
  + rotate(currentToken: RefreshToken, newToken: RefreshToken): void
  + detectReuse(token: RefreshToken): Boolean
  + revokeFamily(reason: String): void
}

class UserSession <<Entity>> {
  - id: String
  - userId: String
  - oauth2ClientId: String
  - deviceFingerprintId: String
  - ipAddress: String
  - userAgent: String
  - expiresAt: DateTime
  - isRevoked: Boolean
  - lastAccessedAt: DateTime
  - createdAt: DateTime
  --
  + isSessionValid(): Boolean
  + refreshSession(): void
  + revokeSession(): void
}

class DeviceFingerprint <<Entity>> {
  - id: String
  - userId: String
  - deviceHash: String
  - signalHash: String
  - userAgent: String
  - ipAddress: String
  - os: String
  - browser: String
  - geoCountry: String
  - confidenceScore: Decimal
  - trusted: Boolean
  - firstSeenAt: DateTime
  - lastSeenAt: DateTime
  - expiresAt: DateTime
  --
  + matches(signalHash: String): Boolean
  + markTrusted(): void
}

class TrustedDevice <<Entity>> {
  - id: String
  - userId: String
  - deviceFingerprintId: String
  - trustedUntil: DateTime
  - revokedAt: DateTime
  - createdAt: DateTime
  --
  + isTrusted(): Boolean
  + revoke(): void
}

class LoginHistory <<Entity>> {
  - id: String
  - userId: String
  - deviceFingerprintId: String
  - timestamp: DateTime
  - userAgent: String
  - ipAddress: String
  - riskLevel: RiskLevel
  - loginSuccessful: Boolean
  - failureReason: String
  --
  + isAnomalous(): Boolean
}

class SecurityPolicy <<Entity>> {
  - id: String
  - policyName: String
  - maxLoginAttempts: Integer
  - maxMfaAttempts: Integer
  - passwordHistoryLimit: Integer
  - lockoutDurationMinutes: Integer
  - sessionTimeoutMinutes: Integer
  - maxConcurrentSessions: Integer
  - mfaRequired: Boolean
  - riskMfaThreshold: RiskLevel
  - stepUpSensitivityThreshold: SensitivityLevel
  - isActive: Boolean
  --
  + isLockoutRequired(failedAttempts: Integer): Boolean
  + requiresMfa(riskLevel: RiskLevel): Boolean
  + requiresStepUp(permission: Permission): Boolean
}

class AuditLog <<Entity>> {
  - id: String
  - userId: String
  - sessionId: String
  - action: AuditAction
  - detail: String
  - ipAddress: String
  - userAgent: String
  - previousLogHash: String
  - logHash: String
  - signature: String
  - timestamp: DateTime
  --
  + verifyHashChain(previousLog: AuditLog): Boolean
}

class SigningKey <<Entity>> {
  - keyId: String
  - algorithm: String
  - activeFrom: DateTime
  - expiresAt: DateTime
  - archivedAt: DateTime
  --
  + isActive(): Boolean
}

interface KmsAdapter <<External Service>> {
  + sign(keyId: String, payload: String): String
  + verify(keyId: String, payload: String, signature: String): Boolean
}

class AuditIntegrityService <<Service>> {
  + sign(log: AuditLog): void
  + verify(log: AuditLog, previousLog: AuditLog): Boolean
  --
}

class TokenSerializer <<Service>> {
  + buildIdToken(idToken: IdToken): String
  + signAccessToken(token: AccessToken): String
  + verifyJwt(jwt: String): Boolean
}

' ===== APPLICATION SERVICES =====

class AuthenticationService <<Service>> {
  + login(username: String, password: String, device: DeviceFingerprint): UserSession
  + continueWithMfa(userId: String, sessionId: String): MfaChallenge
  + logout(sessionId: String): void
  + changePassword(userId: String, oldPassword: String, newPassword: String): Boolean
  + requestPasswordReset(email: String): PasswordResetToken
  + resetPassword(token: String, newPassword: String): Boolean
}

class OAuth2AuthorizationService <<Service>> {
  + authorize(clientId: String, userId: String, scopes: List~String~): AuthorizationCode
  + exchangeCode(code: String, codeVerifier: String): AccessToken
  + refresh(refreshToken: String): AccessToken
  + validateToken(token: String): Boolean
  + revokeToken(tokenId: String): void
}

class TokenIntrospectionService <<Service>> {
  + introspect(token: String): Boolean
  + resolvePermissions(token: AccessToken): List~Permission~
}

class MfaService <<Service>> {
  + enrollTotp(userId: String): TotpCredential
  + enrollWebAuthn(userId: String, publicKey: String): WebAuthnCredential
  + createChallenge(userId: String, type: MfaType): MfaChallenge
  + verify(userId: String, proof: String): Boolean
  + regenerateRecoveryCodes(userId: String, credentialId: String): RecoveryCodeSet
  + disable(userId: String, credentialId: String): void
}

class SecurityEngine <<Service>> {
  + assessLogin(user: User, device: DeviceFingerprint): RiskLevel
  + evaluateStepUpRisk(permission: Permission): Boolean
}

class UserManagementService <<Service>> {
  + createUser(username: String, email: String): User
  + lockUser(userId: String): void
  + unlockUser(userId: String): void
  + assignRole(userId: String, roleId: String): void
  + revokeRole(userId: String, roleId: String): void
}

class AuthorizationService <<Service>> {
  + hasPermission(userId: String, resource: String, action: String): Boolean
  + getEffectivePermissions(userId: String): List~Permission~
  + requiresStepUp(userId: String, permission: Permission): Boolean
}

class RiskEvaluationService <<Service>> {
  + evaluate(device: DeviceFingerprint, history: List~LoginHistory~): RiskLevel
  + detectAnomaly(device: DeviceFingerprint): Boolean
}

class PolicyEnforcementService <<Service>> {
  + enforceLoginPolicy(user: User): void
  + enforceMfaPolicy(challenge: MfaChallenge): void
  + enforcePasswordPolicy(user: User, newPassword: String): void
  + enforceStepUpPolicy(userId: String, permission: Permission): void
}

class DomainEvent <<Event>> {
  - id: String
  - eventType: DomainEventType
  - aggregateId: String
  - aggregateType: AggregateType
  - occurredAt: DateTime
  - correlationId: String
  - causationId: String
  --
  + serialize(): String
}

class LoginFailedEvent <<Event>> {
  - userId: String
  - username: String
  - ipAddress: String
  - userAgent: String
  - deviceFingerprintId: String
  - failureReason: String
  - riskLevel: RiskLevel
}

class LoginSucceededEvent <<Event>> {
  - userId: String
  - sessionId: String
  - deviceFingerprintId: String
  - riskLevel: RiskLevel
}

class MfaVerifiedEvent <<Event>> {
  - userId: String
  - mfaCredentialId: String
  - challengeId: String
  - mfaType: MfaType
}

class RefreshTokenReusedEvent <<Event>> {
  - userId: String
  - oauth2ClientId: String
  - refreshTokenFamilyId: String
  - reusedTokenId: String
  - sessionId: String
}

class TokenIssuedEvent <<Event>> {
  - userId: String
  - oauth2ClientId: String
  - tokenId: String
  - tokenType: TokenType
  - grantedScopeNames: List~String~
}

class UserLockedEvent <<Event>> {
  - userId: String
  - reason: String
  - lockedAt: DateTime
}

interface EventBus <<Messaging>> {
  + publish(event: DomainEvent): void
  + subscribe(eventType: DomainEventType, handler: EventHandler): void
}

interface EventHandler <<Messaging>> {
  + handle(event: DomainEvent): void
}

class DomainEventPublisher <<Service>> {
  + publish(event: DomainEvent): void
  + publishAll(events: List~DomainEvent~): void
}

class AuditEventHandler <<EventHandler>> {
  + handle(event: DomainEvent): void
}

class NotificationEventHandler <<EventHandler>> {
  + handle(event: DomainEvent): void
}

class SiemEventHandler <<EventHandler>> {
  + handle(event: DomainEvent): void
}

class AnalyticsEventHandler <<EventHandler>> {
  + handle(event: DomainEvent): void
}

' ===== BOUNDED CONTEXT / AGGREGATE GROUPS =====

package "Identity & RBAC" {
  class User
  class Role
  class Permission
  class UserRole
  class RolePermission
  class ClientScopeGrant
  class ScopePermission
  class UserConsent
  class UserManagementService
  class AuthorizationService
}

package "MFA" {
  class MfaCredential
  class TotpCredential
  class WebAuthnCredential
  class RecoveryCodeSet
  class RecoveryCode
  class MfaChallenge
  class MfaService
}

package "OAuth2 / OIDC" {
  class OAuth2Client
  class OAuth2Scope
  class OAuth2Token
  class AccessToken
  class RefreshToken
  class IdToken
  class AuthorizationCode
  class RefreshTokenFamily
  class UserSession
  class TokenSerializer
  class OAuth2AuthorizationService
  class TokenIntrospectionService
}

package "Session, Risk & Policy" {
  class DeviceFingerprint
  class TrustedDevice
  class LoginHistory
  class SecurityPolicy
  class SecurityEngine
  class RiskEvaluationService
  class PolicyEnforcementService
}

package "Audit & Events" {
  class AuditLog
  class SigningKey
  interface KmsAdapter
  class AuditIntegrityService
  class DomainEvent
  class LoginFailedEvent
  class LoginSucceededEvent
  class MfaVerifiedEvent
  class RefreshTokenReusedEvent
  class TokenIssuedEvent
  class UserLockedEvent
  class DomainEventPublisher
  interface EventBus
}

' ===== RELATIONSHIPS =====

User --> UserStatus
Permission --> SensitivityLevel
MfaCredential --> MfaType
WebAuthnCredential --> AuthenticatorTransport
MfaChallenge --> ChallengeStatus
OAuth2Token --> TokenType
OAuth2Token --> GrantType
OAuth2Client --> ClientType
AuthorizationCode --> CodeChallengeMethod
OAuth2Scope --> SensitivityLevel
IdToken --> AuthenticationMethod
LoginHistory --> RiskLevel
SecurityPolicy --> RiskLevel
SecurityPolicy --> SensitivityLevel
AuditLog --> AuditAction
DomainEvent --> DomainEventType
DomainEvent --> AggregateType
AuditIntegrityService ..> AuditLog
AuditIntegrityService ..> SigningKey
AuditIntegrityService ..> KmsAdapter
TokenSerializer ..> IdToken
TokenSerializer ..> AccessToken
TokenSerializer ..> SigningKey
TokenSerializer ..> KmsAdapter

User " 1 " -- " 0..* " UserRole
Role " 1 " -- " 0..* " UserRole
Role " 1 " -- " 0..* " RolePermission
Permission " 1 " -- " 0..* " RolePermission
OAuth2Scope " 1 " -- " 0..* " ScopePermission
Permission " 1 " -- " 0..* " ScopePermission

User " 1 " *-- " 0..* " PasswordHistory
User " 1 " o-- " 0..* " PasswordResetToken
User " 1 " o-- " 0..* " MfaCredential
TotpCredential --|> MfaCredential
WebAuthnCredential --|> MfaCredential
MfaCredential " 1 " *-- " 0..* " RecoveryCodeSet
RecoveryCodeSet " 1 " *-- " 0..* " RecoveryCode
MfaCredential " 1 " -- " 0..* " MfaChallenge
User " 1 " -- " 0..* " MfaChallenge

User " 1 " o-- " 0..* " UserSession
OAuth2Client " 1 " -- " 0..* " ClientScopeGrant
OAuth2Scope " 1 " -- " 0..* " ClientScopeGrant
User " 1 " -- " 0..* " UserConsent
OAuth2Client " 1 " -- " 0..* " UserConsent
OAuth2Client " 1 " -- " 0..* " UserSession
UserSession " 1 " -- " 0..* " AccessToken
OAuth2Client " 1 " -- " 0..* " AccessToken
User " 1 " -- " 0..* " AccessToken
AccessToken --|> OAuth2Token
RefreshToken --|> OAuth2Token
OAuth2Client " 1 " -- " 0..* " AuthorizationCode
RefreshTokenFamily " 1 " *-- " 0..* " RefreshToken
RefreshToken " 0..1 parent " -- " 0..* children " RefreshToken
User " 1 " -- " 0..* " RefreshTokenFamily
OAuth2Client " 1 " -- " 0..* " RefreshTokenFamily

User " 1 " -- " 0..* " DeviceFingerprint
User " 1 " -- " 0..* " TrustedDevice
DeviceFingerprint " 1 " -- " 0..* " TrustedDevice
DeviceFingerprint " 1 " -- " 0..* " UserSession
DeviceFingerprint " 1 " -- " 0..* " LoginHistory
User " 1 " -- " 0..* " LoginHistory
User " 1 " -- " 0..* " AuditLog
UserSession " 0..1 " -- " 0..* " AuditLog

LoginFailedEvent --|> DomainEvent
LoginSucceededEvent --|> DomainEvent
MfaVerifiedEvent --|> DomainEvent
RefreshTokenReusedEvent --|> DomainEvent
TokenIssuedEvent --|> DomainEvent
UserLockedEvent --|> DomainEvent
LoginFailedEvent --> RiskLevel
LoginSucceededEvent --> RiskLevel
MfaVerifiedEvent --> MfaType
TokenIssuedEvent --> TokenType
DomainEventPublisher ..> EventBus
EventBus ..> EventHandler
AuditEventHandler ..|> EventHandler
NotificationEventHandler ..|> EventHandler
SiemEventHandler ..|> EventHandler
AnalyticsEventHandler ..|> EventHandler

AuthenticationService ..> SecurityEngine
AuthenticationService ..> MfaService
AuthenticationService ..> DomainEventPublisher

OAuth2AuthorizationService ..> DomainEventPublisher
OAuth2AuthorizationService ..> IdToken
OAuth2AuthorizationService ..> TokenSerializer


MfaService ..> DomainEventPublisher

SecurityEngine ..> RiskEvaluationService
SecurityEngine ..> SecurityPolicy
