@startuml IAM_MFA_DAM_DAO_Class_Diagram

title IAM/MFA System - DAM/DAO Repository Class Diagram

left to right direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 45
hide circle

' ===== APPLICATION SERVICES =====

class AuthenticationService <<Service>> {
  + login(username: String, password: String, device: DeviceFingerprint): UserSession
  + logout(sessionId: String): void
  + changePassword(userId: String, oldPassword: String, newPassword: String): Boolean
  + requestPasswordReset(email: String): PasswordResetToken
  + resetPassword(token: String, newPassword: String): Boolean
}

class OAuth2AuthorizationService <<Service>> {
  + authorize(clientId: String, userId: String, scopes: List~String~): AuthorizationCode
  + exchangeCode(code: String, codeVerifier: String): AccessToken
  + refresh(refreshToken: String): AccessToken
  + validateToken(token: String): Boolean
  + revokeToken(tokenId: String): void
}

class TokenIntrospectionService <<Service>> {
  + introspect(token: String): Boolean
  + resolvePermissions(token: AccessToken): List~Permission~
}

class PermissionResolver <<Service>> {
  + resolveEffectivePermissions(userId: String): List~Permission~
  + hasPermission(userId: String, resource: String, action: String): Boolean
}

interface UnitOfWork <<Transaction>> {
  + begin(): void
  + commit(): void
  + rollback(): void
}

class MfaService <<Service>> {
  + enrollTotp(userId: String): TotpCredential
  + enrollWebAuthn(userId: String, publicKey: String): WebAuthnCredential
  + createChallenge(userId: String, type: MfaType): MfaChallenge
  + verify(userId: String, proof: String): Boolean
  + regenerateRecoveryCodes(userId: String, credentialId: String): RecoveryCodeSet
  + disable(userId: String, credentialId: String): void
}

class SecurityEngine <<Service>> {
  + assessLogin(user: User, device: DeviceFingerprint): RiskLevel
  + requiresStepUp(permission: Permission): Boolean
  + enforce(user: User, policy: SecurityPolicy): void
}

class UserManagementService <<Service>> {
  + createUser(username: String, email: String): User
  + lockUser(userId: String): void
  + unlockUser(userId: String): void
  + assignRole(userId: String, roleId: String): void
  + revokeRole(userId: String, roleId: String): void
}

class AuthorizationService <<Service>> {
  + hasPermission(userId: String, resource: String, action: String): Boolean
  + getEffectivePermissions(userId: String): List~Permission~
  + requiresStepUp(userId: String, permission: Permission): Boolean
}

class DomainEvent <<Event>> {
  - id: String
  - eventType: DomainEventType
  - aggregateId: String
  - aggregateType: String
  - occurredAt: DateTime
  - correlationId: String
  - causationId: String
  --
  + serialize(): String
}

interface EventHandler <<Messaging>> {
  + handle(event: DomainEvent): void
}

class DomainEventPublisher <<Service>> {
  + publish(event: DomainEvent): void
  + publishAll(events: List~DomainEvent~): void
}

class EventDispatcher <<Service>> {
  + dispatch(event: DomainEvent): void
  + replayPending(): void
}

class AuditEventHandler <<EventHandler>> {
  + handle(event: DomainEvent): void
}

' ===== DAM / DAO LAYER =====

interface UserRepository <<Repository>> {
  + findById(id: String): Optional~User~
  + findByUsername(username: String): Optional~User~
  + save(user: User): void
  + updateStatus(userId: String, status: UserStatus): void
}

interface RoleRepository <<Repository>> {
  + findRolesByUserId(userId: String): List~Role~
  + assignRole(userRole: UserRole): void
  + removeRole(userId: String, roleId: String): void
  + save(role: Role): void
}

interface PermissionRepository <<Repository>> {
  + findPermissionsByRoleId(roleId: String): List~Permission~
  + findEffectivePermissionsByUserId(userId: String): List~Permission~
  + grantPermission(rolePermission: RolePermission): void
  + revokePermission(roleId: String, permissionId: String): void
  + save(permission: Permission): void
}

interface PasswordResetTokenRepository <<Repository>> {
  + findByTokenHash(tokenHash: String): Optional~PasswordResetToken~
  + save(token: PasswordResetToken): void
  + markUsed(tokenId: String): void
}

interface MfaCredentialRepository <<Repository>> {
  + findByUserId(userId: String): List~MfaCredential~
  + save(credential: MfaCredential): void
  + delete(id: String): void
}

interface RecoveryCodeSetRepository <<Repository>> {
  + findActiveByCredentialId(credentialId: String): Optional~RecoveryCodeSet~
  + save(codeSet: RecoveryCodeSet): void
  + invalidateByCredentialId(credentialId: String): void
}

interface MfaChallengeRepository <<Repository>> {
  + findActiveByUserId(userId: String): List~MfaChallenge~
  + findActiveByCredentialId(credentialId: String): Optional~MfaChallenge~
  + save(challenge: MfaChallenge): void
  + updateStatus(challengeId: String, status: ChallengeStatus): void
  + deleteExpired(): Integer
}

interface OAuth2ClientRepository <<Repository>> {
  + findByClientId(clientId: String): Optional~OAuth2Client~
  + save(client: OAuth2Client): void
  + rotateSecret(clientId: String, newSecretHash: String): void
  + deactivate(clientId: String): void
}

interface OAuth2ScopeRepository <<Repository>> {
  + findByScopeName(scopeName: String): Optional~OAuth2Scope~
  + findAllowedByClientId(clientId: String): List~OAuth2Scope~
  + save(scope: OAuth2Scope): void
}

interface AuthorizationCodeRepository <<Repository>> {
  + findByCodeHash(codeHash: String): Optional~AuthorizationCode~
  + save(code: AuthorizationCode): void
  + consume(codeId: String): void
}

interface AccessTokenRepository <<Repository>> {
  + findByTokenHash(tokenHash: String): Optional~AccessToken~
  + save(token: AccessToken): void
  + revoke(tokenId: String): void
  + deleteExpired(): Integer
}

interface RefreshTokenRepository <<Repository>> {
  + findByTokenHash(tokenHash: String): Optional~RefreshToken~
  + findByFamilyId(familyId: String): List~RefreshToken~
  + save(token: RefreshToken): void
  + revoke(tokenId: String): void
  + revokeFamily(familyId: String): void
}

interface RefreshTokenFamilyRepository <<Repository>> {
  + findById(id: String): Optional~RefreshTokenFamily~
  + findActiveByUserAndClient(userId: String, clientId: String): Optional~RefreshTokenFamily~
  + save(family: RefreshTokenFamily): void
  + revoke(familyId: String): void
}

interface UserSessionRepository <<Repository>> {
  + findById(id: String): Optional~UserSession~
  + findActiveByUserId(userId: String): List~UserSession~
  + save(session: UserSession): void
  + revoke(sessionId: String): void
}

interface DeviceFingerprintRepository <<Repository>> {
  + findByHash(deviceHash: String): Optional~DeviceFingerprint~
  + save(device: DeviceFingerprint): void
}

interface TrustedDeviceRepository <<Repository>> {
  + findByUserAndDevice(userId: String, deviceFingerprintId: String): Optional~TrustedDevice~
  + save(device: TrustedDevice): void
}

interface LoginHistoryRepository <<Repository>> {
  + findRecentLoginHistory(userId: String): List~LoginHistory~
  + save(history: LoginHistory): void
}

interface RateLimitRepository <<Repository>> {
  + incrementAttempt(key: String): Integer
  + reset(key: String): void
  + isLimited(key: String): Boolean
  + getRemainingAttempts(key: String): Integer
  + getResetTime(key: String): DateTime
}

interface IdempotencyRepository <<Repository>> {
  + findResult(key: String): Optional~String~
  + saveResult(key: String, result: String): void
  + markInProgress(key: String): Boolean
}

interface SecurityPolicyRepository <<Repository>> {
  + findActivePolicy(): Optional~SecurityPolicy~
  + save(policy: SecurityPolicy): void
}

interface AuditLogRepository <<Repository>> {
  + save(log: AuditLog): void
  + findByUserId(userId: String): List~AuditLog~
  + findByDateRange(from: DateTime, to: DateTime): List~AuditLog~
  + findByAction(action: AuditAction): List~AuditLog~
  + findByIpAddress(ipAddress: String): List~AuditLog~
}

interface EventStoreRepository <<Repository>> {
  + append(event: DomainEvent, expectedVersion: Long): void
  + findByAggregateId(aggregateId: String, fromVersion: Long, toVersion: Long): List~DomainEvent~
  + findPendingDispatch(limit: Integer): List~DomainEvent~
}

interface PermissionCacheRepository <<Repository>> {
  + getEffectivePermissions(userId: String): Optional~List~Permission~~
  + putEffectivePermissions(userId: String, permissions: List~Permission~, ttlSeconds: Integer): void
  + invalidateUser(userId: String): void
}

interface JwtKeyRepository <<Repository>> {
  + findActiveSigningKey(): Optional~JwtSigningKey~
  + findByKeyId(keyId: String): Optional~JwtSigningKey~
  + save(key: JwtSigningKey): void
  + rotate(key: JwtSigningKey): void
}

interface UserConsentRepository <<Repository>> {
  + findActiveConsent(userId: String, clientId: String): Optional~UserConsent~
  + save(consent: UserConsent): void
  + revoke(consentId: String): void
}

